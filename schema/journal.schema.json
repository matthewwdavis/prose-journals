{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/matthewwdavis/labapp/labapp/journal.schema.json",
 "title": "A journal file for prose and mosaic",
 "description": "One journal: who publishes it, its page, its sections, its rules for figures, legends, references, LaTeX and Word. docs/journal-format.md in prose explains every field. Only format, id and name are needed; everything else has a default.",
 "type": "object",
 "required": ["format", "id", "name"],
 "properties": {
  "$schema": {"type": "string"},
  "format": {"const": 1, "description": "The version of this file format (1). A newer number is from a newer prose or mosaic."},
  "id": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$", "description": "A short name in lower-case letters, digits and _ (\"tree_genetics_genomes\"). It stays the same when the name changes."},
  "name": {"type": "string", "minLength": 1, "maxLength": 120},
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "This file's own version, 1.0.0; the first number goes up when a change would alter documents already written for it."},
  "kind": {"enum": ["journal", "house", "thesis", "letter", "general"]},
  "publisher": {"type": "string"},
  "group": {"type": "string", "description": "The group the menus list it under (Springer Nature, Cell Press...); the publisher when absent."},
  "issn": {"type": "object", "additionalProperties": false, "properties": {"print": {"$ref": "#/$defs/issn"}, "online": {"$ref": "#/$defs/issn"}}},
  "aliases": {"type": "array", "items": {"type": "string"}},
  "homepage": {"$ref": "#/$defs/url"},
  "guidelines": {"$ref": "#/$defs/url"},
  "verified": {"type": "object", "additionalProperties": false, "properties": {
   "status": {"enum": ["verified", "community", "unverified"]}, "by": {"type": "string"}, "date": {"$ref": "#/$defs/date"}, "note": {"type": "string"}}},
  "maintainers": {"type": "array", "items": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {
   "name": {"type": "string"}, "github": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"}}}},
  "page": {"type": "object", "additionalProperties": false, "properties": {
   "paper": {"enum": ["a4", "letter"]}, "margin_mm": {"type": "number", "minimum": 5, "maximum": 60}}},
  "captions": {"type": "object", "additionalProperties": false, "properties": {
   "label": {"type": "string", "minLength": 1, "maxLength": 20}, "bar": {"type": "boolean"}}},
  "text": {"type": "object", "additionalProperties": false, "properties": {
   "styles": {"type": "object", "propertyNames": {"enum": ["normal", "title", "h1", "h2", "h3", "quote", "caption"]},
              "additionalProperties": {"$ref": "#/$defs/style"}},
   "leading_em": {"type": "number", "minimum": 0.2, "maximum": 3},
   "look": {"type": "object"},
   "numbered_headings": {"type": "boolean"}}},
  "structure": {"type": "object", "additionalProperties": false, "properties": {
   "abstract": {"type": "object", "additionalProperties": false, "properties": {
    "name": {"type": "string"}, "words": {"type": ["integer", "null"], "minimum": 1}, "headings": {"type": "array", "items": {"type": "string"}}}},
   "keywords": {"type": "object", "additionalProperties": false, "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 1}}},
   "running_title": {"type": "object", "additionalProperties": false, "properties": {"chars": {"type": "integer", "minimum": 1}}},
   "front": {"type": "array", "items": {"$ref": "#/$defs/part"}},
   "body": {"type": "array", "items": {"$ref": "#/$defs/part"}},
   "back": {"type": "array", "items": {"$ref": "#/$defs/part"}},
   "omit": {"type": "array", "items": {"$ref": "#/$defs/kind"}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "statements": {"type": "object", "additionalProperties": false, "properties": {
   "contributions": {"enum": ["credit_list", "sentence"]}, "ai": {"enum": ["methods", "acknowledgements"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
  "limits": {"type": "object", "additionalProperties": false, "properties": {
   "article_type": {"type": "string"}, "source": {"type": "string"}, "checked": {"$ref": "#/$defs/date"},
   "limits": {"type": "object", "additionalProperties": false, "properties": {
    "title_chars": {"$ref": "#/$defs/count"}, "title_words": {"$ref": "#/$defs/count"}, "abstract_words": {"$ref": "#/$defs/count"},
    "summary_words": {"$ref": "#/$defs/count"}, "main_text_words": {"$ref": "#/$defs/count"}, "methods_words": {"$ref": "#/$defs/count"},
    "legend_words": {"$ref": "#/$defs/count"}, "display_items": {"$ref": "#/$defs/count"}, "figures": {"$ref": "#/$defs/count"},
    "tables": {"$ref": "#/$defs/count"}, "references": {"$ref": "#/$defs/count"}, "keywords": {"$ref": "#/$defs/count"}}},
   "counts": {"type": ["string", "null"]}, "notes": {"type": "string"},
   "summary_name": {"type": "string", "description": "What the journal calls the summary counted as summary_words."},
   "limit_notes": {"type": ["object", "string"], "description": "A note on each limit, for the Word Count window."},
   "unverified": {"type": ["object", "array", "string", "null"]},
   "count": {"type": "object", "additionalProperties": false, "properties": {
    "abstract": {"type": "boolean"}, "methods": {"type": "boolean"}, "legends": {"type": "boolean"}}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "legends": {"type": "object", "additionalProperties": false, "properties": {
   "sep": {"enum": [" |", ".", ""]},
   "title": {"type": "object", "additionalProperties": false, "properties": {"bold": {"type": "boolean"}, "line": {"type": "boolean"}}},
   "panels": {"type": "object", "additionalProperties": false, "properties": {
    "open": {"type": "string", "maxLength": 2}, "close": {"type": "string", "maxLength": 2}, "bold": {"enum": ["letter", "all", null]},
    "italic": {"type": "boolean"}, "newline": {"type": "boolean"}, "case": {"enum": ["lower", "upper", null]}}},
   "scale": {"type": "number", "minimum": 0.5, "maximum": 1.5},
   "table": {"type": "object", "additionalProperties": false, "properties": {
    "sep": {"enum": [" |", ".", ""]}, "title": {"type": "object", "additionalProperties": false, "properties": {"bold": {"type": "boolean"}, "line": {"type": "boolean"}}}}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "figure_refs": {"type": ["object", "null"], "additionalProperties": false, "properties": {
   "main": {"$ref": "#/$defs/pair"}, "start": {"$ref": "#/$defs/pair"}, "outside": {"$ref": "#/$defs/pair"},
   "range": {"type": "string"}, "list": {"enum": ["and", "serial", "commas", null]},
   "panels": {"type": ["object", "null"], "additionalProperties": false, "properties": {
    "case": {"enum": ["lower", "upper", null]}, "style": {"type": ["object", "null"]}}},
   "supp": {"type": ["object", "null"]}, "extended": {"type": ["object", "null"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
  "house_style": {"type": ["object", "null"], "additionalProperties": false, "properties": {
   "p": {"type": "object", "additionalProperties": false, "properties": {
    "letter": {"enum": ["P", "p"]}, "italic": {"type": "boolean"}, "space": {"type": "boolean"}, "zero": {"type": "boolean"}}},
   "etal": {"type": "object", "additionalProperties": false, "properties": {"italic": {"type": "boolean"}}},
   "unit_space": {"enum": ["nbsp"]}, "range": {"enum": ["–", " to "]}, "small": {"enum": ["words", "numerals"]},
   "thousands": {"type": "object", "additionalProperties": false, "properties": {"sep": {"enum": [",", " ", ""]}, "from": {"enum": [4, 5]}}},
   "percent": {"type": "object", "additionalProperties": false, "properties": {"space": {"type": "boolean"}}},
   "celsius": {"type": "object", "additionalProperties": false, "properties": {"space": {"type": "boolean"}}},
   "latin": {"type": "object", "additionalProperties": false, "properties": {"italic": {"type": "boolean"}}},
   "units": {"type": "object", "additionalProperties": false, "properties": {
    "h": {"type": "string"}, "s": {"type": "string"}, "mL": {"type": "string"}, "uL": {"type": "string"}, "L": {"type": "string"}}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "house_style_from": {"type": "object", "additionalProperties": {"enum": ["stated", "print"]}},
  "supplement": {"type": "object", "properties": {
   "title": {"type": "string"}, "refs": {"enum": ["own", "continue", "main"]}, "guide": {"type": "boolean"},
   "fig": {"$ref": "#/$defs/supp_item"}, "tbl": {"$ref": "#/$defs/supp_item"}, "data": {"$ref": "#/$defs/supp_item"},
   "note": {"$ref": "#/$defs/supp_item"}, "extended": {"$ref": "#/$defs/supp_item"},
   "list": {"enum": ["files", "legends", "brief", "titles", "documents", null]}, "list_where": {"enum": ["section", "methods", "data_availability"]},
   "list_heading": {"type": ["string", "null"]}, "data_after_file": {"type": "boolean"}, "large_tables": {"enum": ["xlsx", null]},
   "large_rows": {"type": "integer", "minimum": 1}, "contents": {"enum": ["includes", null]}, "cover_title": {"type": ["string", "null"]},
   "files": {"enum": ["one", "each"]}, "file_names": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
   "formats": {"type": "array", "items": {"enum": ["pdf", "docx"]}}, "legends_file": {"type": "boolean"},
   "legend_link": {"enum": ["related", "supports", null], "description": "Each supplementary figure's legend names the main figure it goes with: \"related\" (Cell's \", related to Figure 1\"), \"supports\" (The Plant Cell's \"Supports Figure 1\")."},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "table_notes": {"type": "object", "additionalProperties": false, "properties": {
   "marks": {"anyOf": [{"const": "letters"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]}, "italic": {"type": "boolean"},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "cover_letter": {"type": "object", "additionalProperties": false, "properties": {
   "type": {"type": "string"}, "reviewers": {"enum": ["letter", "excluded", "form", null]}, "points": {"type": "array", "items": {"type": "string"}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "abbreviations": {"type": "object", "additionalProperties": false, "properties": {
   "abstract": {"enum": ["own", "none"]}, "legends": {"type": "boolean"}, "min": {"type": "integer", "minimum": 1}, "evidence": {"$ref": "#/$defs/evidence"}}},
  "submission": {"type": "object", "additionalProperties": false, "properties": {
   "first": {"$ref": "#/$defs/stage"}, "revision": {"$ref": "#/$defs/stage"}, "anonymised": {"enum": ["required", "optional", "no"]},
   "alt_text": {"type": "boolean"}, "from": {"enum": ["unconfirmed"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
  "references": {"type": "object", "additionalProperties": false, "properties": {
   "csl": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+$", "description": "The style's name in the Citation Style Language repository (zotero.org/styles): the end of its address."},
   "citations": {"enum": ["numeric", "author-date", "note", "label", "author"], "description": "How the reference style cites in the text: numbers (numeric), author and year (author-date), footnotes (note), labels or author names. Read from the CSL style when a journal is started from it; the style itself decides."},
   "file": {"type": "string", "description": "A .csl file beside this one (for a built-in journal: prose's own copy, templates/csl/)."},
   "csl_text": {"type": "string", "description": "The style itself, when it isn't in the repository (a journal file passed on)."},
   "overrides": {"type": "object", "properties": {"citation": {"type": "object"}, "bibliography": {"type": "object"}, "evidence": {"type": "string"}}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "latex": {"type": "object", "additionalProperties": false, "properties": {
   "template": {"enum": ["standard", "publisher", "house"]},
   "wrapper": {"type": "string"}, "wrapper_text": {"type": "string"},
   "class": {"type": "string"}, "options": {"type": "string"}, "columns": {"enum": [1, 2]},
   "files": {"type": "object", "additionalProperties": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}},
   "fetch": {"$ref": "#/$defs/fetch"},
   "citations": {"enum": ["csl", "bibtex"]}, "provisional": {"type": "boolean"}, "publisher": {"type": "string"}, "note": {"type": "string"},
   "source_notes": {"type": "string"}, "wrapper_for": {"type": "string"}, "csl_name": {"type": ["string", "null"]},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "word": {"type": "object", "additionalProperties": false, "properties": {
   "layout": {"type": "object"}, "reference_docx": {"type": "string"}, "header_placeholder": {"type": "string"}, "evidence": {"$ref": "#/$defs/evidence"}}},
  "house": {"type": "object", "additionalProperties": false, "properties": {
   "starter": {"type": "string"}, "typst": {"type": "string"}, "thesis": {"type": "boolean"}, "letter": {"type": "boolean"},
   "figure_fit_text": {"type": "boolean"}}},
  "figures": {"type": "object", "additionalProperties": false, "properties": {
   "name": {"type": "string"}, "listed": {"type": "boolean"},
   "depth_mm": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 5000},
   "types": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "required": ["name", "width_mm"], "additionalProperties": false,
    "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 60}, "width_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000}}}},
   "any_width": {"type": "boolean"}, "max_width_mm": {"type": "number", "exclusiveMinimum": 0},
   "note": {"type": "string"}, "source": {"type": "string"},
   "labels": {"type": "object", "additionalProperties": false, "properties": {
    "font": {"type": "string"}, "size": {"type": "number", "exclusiveMinimum": 0}, "bold": {"type": "boolean"}, "case": {"enum": ["lower", "upper"]},
    "form": {"enum": ["a", "(a)", "a)", "a."]}, "source": {"type": "string"}, "measured": {"type": "boolean"}}},
   "text": {"type": "object", "additionalProperties": false, "properties": {
    "min_pt": {"type": ["number", "null"]}, "max_pt": {"type": ["number", "null"]}, "fonts": {"type": "array", "items": {"type": "string"}},
    "fonts_only": {"type": "boolean"}, "about": {"type": "boolean"}, "source": {"type": "string"}}},
   "lines": {"type": "object", "additionalProperties": false, "properties": {
    "min_pt": {"type": ["number", "null"]}, "max_pt": {"type": ["number", "null"]}, "about": {"type": "boolean"}, "source": {"type": "string"}}},
   "pictures": {"type": "object", "additionalProperties": false, "properties": {
    "photo": {"type": ["number", "null"]}, "combination": {"type": ["number", "null"]}, "line_art": {"type": ["number", "null"]},
    "vector": {"type": "array", "items": {"enum": ["photo", "combination", "line_art"]}}, "source": {"type": "string"}}},
   "export": {"type": "object", "additionalProperties": false, "properties": {
    "formats": {"type": "array", "items": {"enum": ["pdf", "svg", "png", "tiff", "jpeg", "eps", "pptx"]}},
    "colour": {"enum": ["rgb", "rgb_preferred", "either", "cmyk_preferred", "cmyk"]}, "max_mb": {"type": ["number", "null"]},
    "firm": {"type": "boolean"}, "max_dpi": {"type": ["number", "null"]}, "embed_fonts": {"type": "boolean"}, "no_alpha": {"type": "boolean"},
    "source": {"type": "string"}}},
   "evidence": {"$ref": "#/$defs/evidence"}}},
  "sources": {"type": "array", "items": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string"}, "what": {"type": "string"}}}},
  "evidence": {"type": ["object", "array", "string"]}
 },
 "additionalProperties": false,
 "$defs": {
  "url": {"type": "string", "pattern": "^https?://"},
  "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
  "issn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$"},
  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "count": {"type": ["integer", "null"], "minimum": 1},
  "kind": {"type": "string", "pattern": "^[a-z_]+$"},
  "evidence": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
  "pair": {"type": ["array", "null"], "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
  "style": {"type": "object", "additionalProperties": false, "properties": {"font": {"type": "string"}, "size": {"type": "number", "minimum": 4, "maximum": 72}}},
  "part": {"type": "object", "required": ["kind", "name"], "additionalProperties": false, "properties": {
   "kind": {"$ref": "#/$defs/kind"}, "name": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "hint": {"type": "string"},
   "headed": {"type": "boolean"},
   "limit": {"type": "object", "additionalProperties": false, "properties": {
    "words": {"type": "integer", "minimum": 1}, "min": {"type": "integer", "minimum": 1}, "chars": {"type": "integer", "minimum": 1},
    "items": {"type": "integer", "minimum": 1}}}}},
  "supp_item": {"type": ["object", "null"], "additionalProperties": false, "properties": {
   "one": {"$ref": "#/$defs/pair"}, "many": {"$ref": "#/$defs/pair"}, "s": {"type": "boolean"}, "legend": {"$ref": "#/$defs/pair"}}},
  "stage": {"type": "object", "additionalProperties": false, "properties": {
   "formats": {"type": "array", "items": {"enum": ["pdf", "docx", "latex"]}}, "accepts": {"type": "array", "items": {"enum": ["pdf", "docx", "latex"]}},
   "figures": {"enum": ["embedded", "separate", "both"]}, "figure_format": {"enum": ["pdf", "tif"]}, "dpi": {"type": "integer", "minimum": 72},
   "naming": {"type": "string"}, "max_mb": {"type": "number", "exclusiveMinimum": 0}, "tables": {"enum": ["text", "end"]},
   "review_copy": {"type": "boolean"}, "marked_up": {"type": "boolean"}, "pdf_embedded": {"type": "boolean"},
   "also": {"type": "array", "items": {"type": "string"}}}},
  "fetch": {"type": "object", "required": ["store", "files"], "additionalProperties": false, "properties": {
   "store": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "publisher": {"type": "string"}, "what": {"type": "string"},
   "page": {"$ref": "#/$defs/url"}, "url": {"$ref": "#/$defs/url"}, "size_mb": {"type": "number"},
   "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
   "optional": {"type": "object", "additionalProperties": {"type": "object", "properties": {
    "sha256": {"$ref": "#/$defs/sha256"}, "sets": {"type": "string"}, "note": {"type": "string"}}}},
   "derived": {"type": "object", "additionalProperties": {"type": "object", "properties": {"from": {"type": "string"}, "edits": {"type": "string"}}}}}}
 }
}
